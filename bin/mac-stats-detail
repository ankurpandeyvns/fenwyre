#!/usr/bin/env python3
"""mac-stats-detail: one JSON snapshot for the Mac Stats plasmoid dropdown (Stats/iStat-style).

CPU split + per-core, top processes by CPU and memory, memory breakdown + pressure,
network rates/totals/addresses, GPU (per app via gpu-feed), sensors (via mac-stats). Deltas use a shared state file;
calls within 1.5 s of the last sample reuse it, so several panel instances share one sample.
"""
import importlib.machinery, importlib.util, json, os, re, socket, struct, time

RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
STATE = os.path.join(RUN, "mac-stats-detail.json")
SKIP_NET = ("lo", "docker", "veth", "br-", "virbr", "tailscale")
CLK = os.sysconf("SC_CLK_TCK")
PAGE = os.sysconf("SC_PAGE_SIZE")

_l = importlib.machinery.SourceFileLoader("macstats", os.path.expanduser("~/.local/bin/mac-stats"))
_s = importlib.util.spec_from_loader("macstats", _l)
ms = importlib.util.module_from_spec(_s)
_l.exec_module(ms)


def rd(p, d=""):
    try:
        with open(p) as f:
            return f.read()
    except OSError:
        return d


def cpu_times():
    out = {}
    for line in rd("/proc/stat").splitlines():
        if line.startswith("cpu"):
            k, *v = line.split()
            out[k] = [int(x) for x in v[:8]]
    return out


def procs():
    out = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        s = rd(f"/proc/{pid}/stat")
        if not s:
            continue
        r = s.rfind(")")
        name = s[s.find("(") + 1:r]
        f = s[r + 2:].split()
        out[pid] = (name, int(f[11]) + int(f[12]), int(f[21]) * PAGE)
    return out


APP_DIRS = [os.path.expanduser("~/.local/share/applications"), "/usr/local/share/applications",
            "/usr/share/applications", "/var/lib/flatpak/exports/share/applications"]
APP_INDEX = os.path.join(RUN, "mac-stats-apps.json")


def app_index():
    """lowercase key -> [Name, Icon] from .desktop files; cached, rebuilt when a dir changes."""
    stamp = [os.stat(d).st_mtime if os.path.isdir(d) else 0 for d in APP_DIRS]
    try:
        c = json.loads(rd(APP_INDEX, "{}"))
        if c.get("stamp") == stamp:
            return c["idx"]
    except ValueError:
        pass
    idx, weak = {}, {}
    for d in reversed(APP_DIRS):            # later (user) dirs override system ones
        if not os.path.isdir(d):
            continue
        for fn in os.listdir(d):
            if not fn.endswith(".desktop"):
                continue
            e, sect = {}, False
            for line in rd(os.path.join(d, fn)).splitlines():
                if line.startswith("["):
                    if sect:
                        break
                    sect = line.strip() == "[Desktop Entry]"
                elif sect and "=" in line:
                    k, v = line.split("=", 1)
                    e.setdefault(k.strip(), v.strip())
            if not e.get("Name") or e.get("Type", "Application") != "Application":
                continue
            val = [e["Name"], e.get("Icon", "application-x-executable")]
            fid = fn[:-8]
            exe = os.path.basename((e.get("TryExec") or e.get("Exec", "").split(" ")[0]).strip('"'))
            keys = {fid, fid.split(".")[-1], exe, e.get("StartupWMClass", "")}
            target = weak if e.get("NoDisplay") == "true" else idx
            for k in keys:
                if k:
                    target[k.lower()] = val
    for k, v in weak.items():
        idx.setdefault(k, v)
    tmp = APP_INDEX + f".{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump({"stamp": stamp, "idx": idx}, f)
    os.replace(tmp, APP_INDEX)
    return idx


def lookup(idx, *cands):
    for c in cands:
        if c and c.lower() in idx:
            return idx[c.lower()]
    return None


def exe_of(pid):
    try:
        return os.path.basename(os.readlink(f"/proc/{pid}/exe")).replace(" (deleted)", "")
    except OSError:
        return ""


# Kernel threads by what they work on. A kworker is named after the work queue it last ran
# ("kworker/u43:7-kcryptd-252:1-2"), so its share moves between categories as its work changes.
KERNEL_CATEGORIES = [   # (pattern on the thread/work-queue name, name, icon); first match wins
    (r"dmcrypt|kcryptd", "Disk Encryption", "security-high"),
    (r"btrfs|jbd|ext4|xfs|f2fs|writeback|flush|kblockd|blk|nvme|apple-ans|scsi|loop\d|zram|mmc", "Disk I/O", "drive-harddisk"),
    (r"asahi|drm|dcp|afk|gpu|disp|hdmi|\bavd", "Graphics & Display", "video-display"),
    (r"tas27|snd|sound|audio|cs42l|mca", "Audio", "audio-card"),
    (r"brcmf|wlan|wifi|80211|net|ipv6|addrconf|wg-|bluetooth|\bhci|rfcomm", "Network & Bluetooth", "network-wireless"),
    (r"usb|xhci|dwc3|typec|tps659|thunderbolt|\batc", "USB & Thunderbolt", "drive-removable-media-usb"),
    (r"kswapd|kcompactd|ksmd|oom_reaper|mm_percpu|zswap|khugepaged|psimon|vmstat", "Memory Management", "memory"),
    (r"^irq/|ksoftirqd", "Interrupts", "cpu"),
]
KERNEL_OTHER = ["Kernel", "computer-laptop"]


def kernel_category(comm):
    work = comm.split("-", 1)[1] if comm.startswith("kworker/") and "-" in comm else comm
    for i, (pat, _, _) in enumerate(KERNEL_CATEGORIES):
        if re.search(pat, work, re.I):
            return str(i)
    return "other"


def same_process(old, new):
    """The same process in two samples: its name is unchanged, or it is a kworker that ran other work."""
    return old == new or (old.startswith("kworker/") and old.split("-", 1)[0] == new.split("-", 1)[0])


def unesc(unit):
    """systemd unit-name escapes: app-orca\\x2dide -> app-orca-ide."""
    return re.sub(r"\\x([0-9a-fA-F]{2})", lambda m: chr(int(m.group(1), 16)), unit)


def group_of(pid, comm, cache):
    """(key, leader pid, scope id) — whole apps by their systemd app scope, terminal commands alone."""
    cg = unesc(rd(f"/proc/{pid}/cgroup").strip().split("::", 1)[-1])
    if not cg or cg == "/":
        return ("kernel:" + kernel_category(comm), None, None)
    if "/tab(" in cg or "/main.scope" in cg and "konsole" not in cg:
        return ("cmd:" + comm, pid, None)
    m = re.search(r"/app-([^/]+?)(?:-(\d+))?\.scope", cg) or re.search(r"/app-([^/@]+?)(?:@[^/]*)?\.service", cg)
    if m:
        g = m.groups() + (None,)
        return ("app:" + m.group(0), g[1], g[0])
    m = re.search(r"/session\.slice/([^/]+)\.service", cg) or re.search(r"/([^/]+)\.service$", cg)
    if m:
        return ("svc:" + m.group(1), None, m.group(1))
    return ("cmd:" + comm, pid, None)


