# Command-line programs with their own icon (by executable, process name or script name).
CLI_APPS = {"claude": ["Claude Code", "claude"], "codex": ["Codex", "codex-desktop"],
            "codex.js": ["Codex", "codex-desktop"]}
SERVICE_ICON = "preferences-system"
UNKNOWN_ICON = "exec"   # WhiteSur's application-x-executable is a dark grey square, invisible on the popup
INTERPRETERS = re.compile(r"(python[0-9.]*|bash|sh|dash|perl|ruby|node)")
UNIT_DIRS = ["/etc/systemd/system", "/run/systemd/system", "/usr/lib/systemd/system",
             os.path.expanduser("~/.config/systemd/user"), "/etc/systemd/user", "/usr/lib/systemd/user"]


def script_of(pid):
    """The script an interpreter runs ('python3 -I /usr/local/bin/gpu-feed' -> 'gpu-feed'), or ''."""
    try:
        args = rd(f"/proc/{pid}/cmdline").split("\0")
    except UnicodeDecodeError:
        return ""
    if not args or not INTERPRETERS.fullmatch(os.path.basename(args[0])):
        return ""
    it = iter(args[1:])
    for a in it:
        if a in ("-c", "-e"):
            return ""
        if a == "-m":
            return next(it, "").split(".")[-1]
        if a and not a.startswith("-"):
            return os.path.basename(a)
    return ""


def unit_name(unit):
    """A short readable name from the unit's Description=, or ''."""
    base = unit.split("@")[0]
    for d in UNIT_DIRS:
        for f in (f"{unit}.service", f"{base}@.service", f"{base}.service"):
            for line in rd(os.path.join(d, f)).splitlines():
                if line.startswith("Description="):
                    t = re.sub(r"\s*[\(\[].*?[\)\]]\s*", " ", line[12:]).split(" - ")[0].strip()
                    t = re.sub(r"\s+(service|daemon)$", "", t, flags=re.I)
                    ok = t and len(t) <= 28 and ".service" not in t and "%" not in t
                    return t if ok else ""
    return ""


def label(key, leader, scope, comm, pid, idx):
    if key.startswith("kernel:"):
        cat = key.split(":", 1)[1]
        return KERNEL_OTHER if cat == "other" else list(KERNEL_CATEGORIES[int(cat)][1:])
    if key.startswith("cmd:"):
        exe = exe_of(pid)
        script = script_of(pid)
        for n in (exe, comm, script):
            if n in CLI_APPS:
                return CLI_APPS[n]
        if comm in PROGRAM_NAMES or exe in PROGRAM_NAMES:
            return list(PROGRAM_NAMES.get(exe) or PROGRAM_NAMES[comm])
        if script:
            return [script, "python" if exe.startswith("python") or comm.startswith("python") else "utilities-terminal"]
        name = exe if len(comm) >= 15 and exe.startswith(comm) else comm   # comm is cut at 15 chars
        hit = lookup(idx, exe, comm)
        if hit and hit[1] != "application-x-executable":
            return hit
        return [name, PROGRAM_ICONS.get(exe) or PROGRAM_ICONS.get(comm) or "utilities-terminal"]
    if scope in ALIASES:
        return ALIASES[scope]
    if key.startswith("svc:") and scope in SERVICE_NAMES:
        return list(SERVICE_NAMES[scope])
    cands = []
    if leader:
        cands += [exe_of(leader), rd(f"/proc/{leader}/comm").strip()]
    cands += [exe_of(pid), comm]
    if scope:
        s2 = re.sub(r"^(plasma-|app-)", "", scope)
        cands += [scope, s2, s2.split(".")[-1]]
    hit = lookup(idx, *cands)
    if hit:
        if hit[1] == "application-x-executable":
            return [hit[0], SERVICE_ICON if key.startswith("svc:") else UNKNOWN_ICON]
        return hit
    if key.startswith("svc:"):
        exe = exe_of(pid)
        if exe in PROGRAM_NAMES:
            return list(PROGRAM_NAMES[exe])
        unit = unit_name(scope)
        if unit:
            return [unit, SERVICE_ICON]
        name = script_of(pid) or exe or comm
        return [name, PROGRAM_ICONS.get(exe) or PROGRAM_ICONS.get(comm) or SERVICE_ICON]
    return [script_of(pid) or exe_of(pid) or comm, UNKNOWN_ICON]


def net_ifaces():
    out = {}
    for line in rd("/proc/net/dev").splitlines()[2:]:
        k, v = line.split(":", 1)
        k = k.strip()
        v = v.split()
        out[k] = (int(v[0]), int(v[8]))
    return out


def ipv4(ifname):
    for line in os.popen(f"ip -4 -o addr show dev {ifname} 2>/dev/null"):
        return line.split()[3].split("/")[0]
    return ""


def default_iface():
    for line in rd("/proc/net/route").splitlines()[1:]:
        f = line.split()
        if f[1] == "00000000" and not f[0].startswith(SKIP_NET):
            return f[0], socket.inet_ntoa(struct.pack("<L", int(f[2], 16)))
    return "", ""


def meminfo():
    m = {}
    for line in rd("/proc/meminfo").splitlines():
        k, v = line.split(":")
        m[k] = int(v.split()[0]) * 1024
    return m


def pressure():
    for line in rd("/proc/pressure/memory").splitlines():
        if line.startswith("some"):
            return float(line.split()[1].split("=")[1])
    return 0.0


def zram():
    comp = orig = 0
    for d in os.listdir("/sys/block"):
        if d.startswith("zram"):
            f = rd(f"/sys/block/{d}/mm_stat").split()
            if len(f) >= 3:
                orig += int(f[0]); comp += int(f[2])
    return orig, comp



def gpu_dev():
    """The Apple AGX render device (asahi driver exposes agx_stats / gpu_memory)."""
    for c in sorted(os.listdir("/sys/class/drm")):
        d = f"/sys/class/drm/{c}/device"
        if re.fullmatch(r"card\d+", c) and os.path.exists(f"{d}/agx_stats"):
            return d
    return None


def gpu_freqs():
    for t in ("/sys/firmware/devicetree/base/opp-table-gpu",):
        try:
            return [struct.unpack(">Q", open(f"{t}/{n}/opp-hz", "rb").read()[:8])[0] // 1_000_000
                    for n in sorted(os.listdir(t), key=lambda n: int(re.sub(r"\D", "", n) or 0))
                    if os.path.exists(f"{t}/{n}/opp-hz")]
        except (OSError, struct.error):
            pass
    return []


def gpu_raw():
    d = gpu_dev()
    if not d:
        return None
    kv = {}
    for f in ("agx_stats", "gpu_memory"):
        for line in rd(f"{d}/{f}").splitlines():
            k, _, v = line.partition(" ")
            try:
                kv[k] = int(v)
            except ValueError:
                pass
    return kv or None


def sensor_groups(temps):
    """Temperatures by group for the Sensors tab: CPU cores (P then E), GPU, then the rest."""
    def order(t):
        n = t[1]
        g = 0 if n.startswith("CPU performance") else 1 if n.startswith("CPU efficiency") else \
            2 if n.startswith("GPU") else 3
        return (g, n)
    return [[l, round(v, 1), "cpu" if l.startswith("CPU") else "gpu" if l.startswith("GPU") else "system"]
            for _, l, v in sorted(temps, key=order)]


def fan_state():
    """mac-fand status (profile, mode, die temperature), or None when it isn't installed."""
    try:
        with open("/run/mac-fan/state.json") as f:
            st = json.load(f)
        return st if time.time() - st.get("time", 0) < 30 else None
    except (OSError, ValueError):
        return None


def sample():
    now = time.time()
    try:
        prev = json.loads(rd(STATE, "{}"))
    except ValueError:
        prev = {}
    if prev.get("out") and now - prev.get("t", 0) < 1.5:
        return prev["out"]

    ct, pr, nf = cpu_times(), procs(), net_ifaces()
    dt = max(1e-3, now - prev.get("t", 0)) if prev.get("t") else None
    pct = prev.get("cpu", {})

    def split(k):
        a, b = pct.get(k), ct.get(k)
        if not a or not b:
            return 0.0, 0.0, 0.0
        d = [y - x for x, y in zip(a, b)]
        tot = sum(d) or 1
        user, sys_ = d[0] + d[1], d[2] + d[5] + d[6]
        idle = d[3] + d[4]
        return 100 * user / tot, 100 * sys_ / tot, 100 * (1 - idle / tot)

    u, s, tot = split("cpu")
    cores = [round(split(k)[2], 1) for k in sorted((k for k in ct if k != "cpu"), key=lambda k: int(k[3:]))]

    # Top processes grouped by app (systemd app scopes), labelled with the app's name + icon.
    pp = prev.get("procs", {})
    idx = app_index()
    cpu_by, mem_by, labels, resolved = {}, {}, {}, {}
    for pid, (comm, ticks, rss) in pr.items():
        key, leader, scope = group_of(pid, comm, None)
        if key not in resolved:
            lb = label(key, leader, scope, comm, pid, idx)
            resolved[key] = lb[0]
            labels.setdefault(lb[0], lb)
        key = resolved[key]
        mem_by[key] = mem_by.get(key, 0) + rss
        if dt and pid in pp and same_process(pp[pid][0], comm):
            c = 100 * (ticks - pp[pid][1]) / CLK / dt
            if c > 0:
                cpu_by[key] = cpu_by.get(key, 0) + c
    top_cpu = [labels[k] + [round(v, 1)] for k, v in sorted(cpu_by.items(), key=lambda x: -x[1])[:5]]
    top_mem = [labels[k] + [v] for k, v in sorted(mem_by.items(), key=lambda x: -x[1])[:5]]

    # Per-app network rates from nethogs-feed.service (root packet capture), grouped like above.
    net_by = {}
    try:
        nh = json.loads(rd("/run/mac-stats/net.json", "{}"))
    except ValueError:
        nh = {}
    if nh and now - nh.get("t", 0) < 6:
        for pid, up, down in nh.get("procs", []):
            pid = str(pid)
            if pid == "0" or pid not in pr:
                labels.setdefault("Other", ["Other", "network-wired"])
                key = "Other"
            else:
                comm = pr[pid][0]
                k, leader, scope = group_of(pid, comm, None)
                if k not in resolved:
                    lb = label(k, leader, scope, comm, pid, idx)
                    resolved[k] = lb[0]
                    labels.setdefault(lb[0], lb)
                key = resolved[k]
            a = net_by.setdefault(key, [0, 0])
            a[0] += up; a[1] += down
    top_net = [labels[k] + v for k, v in sorted(net_by.items(), key=lambda x: -(x[1][0] + x[1][1]))[:5]]

    # Per-app GPU share from gpu-feed.service (DRM scheduler tracepoints), grouped like above.
    gpu_by = {}
    try:
        gf = json.loads(rd("/run/mac-stats/gpu.json", "{}"))
    except ValueError:
        gf = {}
    if gf and now - gf.get("t", 0) < 6:
        for pid, share in gf.get("procs", []):
            pid = str(pid)
            if pid not in pr:
                continue
            comm = pr[pid][0]
            k, leader, scope = group_of(pid, comm, None)
            if k not in resolved:
                lb = label(k, leader, scope, comm, pid, idx)
                resolved[k] = lb[0]
                labels.setdefault(lb[0], lb)
            gpu_by[resolved[k]] = gpu_by.get(resolved[k], 0) + share

    m = meminfo()
    total, avail = m["MemTotal"], m["MemAvailable"]
    zo, zc = zram()
    app = m.get("AnonPages", 0)
    wired = m.get("SUnreclaim", 0) + m.get("KernelStack", 0) + m.get("PageTables", 0)
    cached = max(0, m.get("Cached", 0) + m.get("Buffers", 0) + m.get("SReclaimable", 0) - m.get("Shmem", 0))

    # Network: default-route interface, rates from all real interfaces.
    pn = prev.get("net", {})
    rx = sum(v[0] for k, v in nf.items() if not k.startswith(SKIP_NET))
    tx = sum(v[1] for k, v in nf.items() if not k.startswith(SKIP_NET))
    rxr = txr = 0.0
    if dt and "rx" in pn:
        rxr, txr = max(0, (rx - pn["rx"]) / dt), max(0, (tx - pn["tx"]) / dt)
    iface, gw = default_iface()

    # GPU: busy time delta (ns) over wall time, falling back to the firmware's util figure.
    g = gpu_raw()
    gpu = None
    pg = prev.get("gpu") or {}
    if g:
        util = float(g.get("util1", 0))
        if dt and "busy_ns" in pg and g.get("busy_ns", 0) >= pg["busy_ns"]:
            util = min(100.0, 100 * (g["busy_ns"] - pg["busy_ns"]) / (dt * 1e9))
        jobs = max(0, (g.get("jobs", 0) - pg["jobs"]) / dt) if dt and "jobs" in pg else 0
        fr = gpu_freqs()
        ps = g.get("pstate", 0)
        # "util" is load vs full capacity: busy time weighted by the clock it ran at (gpu-feed samples
        # this every 50 ms). Busy time alone reads 30% when the GPU idles busy at its lowest clock.
        busy = util
        if gf and now - gf.get("t", 0) < 6 and gf.get("work") is not None:
            util = gf["work"]
        elif fr and 0 <= ps < len(fr) and max(fr):
            util = util * fr[ps] / max(fr)
        gpu = {"util": round(util, 1), "busy": round(busy, 1), "power": round(g.get("power_mw", 0) / 1000, 2),
               "pstate": ps, "mhz": fr[ps] if 0 <= ps < len(fr) else None,
               "maxMhz": max(fr) if fr else None, "jobs": round(jobs),
               "mem": g.get("user_resident", 0) + g.get("kernel_resident", 0),
               "memUser": g.get("user_resident", 0), "memKernel": g.get("kernel_resident", 0),
               "top": [labels[k] + [round(util * v, 1)] for k, v in sorted(gpu_by.items(), key=lambda x: -x[1])[:5]],
               "perApp": bool(gf)}

    temps, fans, powers = ms.hwmon()
    bat = ms.battery()
    hot = sorted(temps, key=lambda x: -x[2])[:5]

    out = {
        "cpu": {"total": round(tot, 1), "user": round(u, 1), "system": round(s, 1),
                "load": rd("/proc/loadavg", "0 0 0").split()[:3], "cores": cores,
                "top": top_cpu},
        "mem": {"total": total, "used": total - avail, "app": app, "wired": wired, "cached": cached,
                "shmem": m.get("Shmem", 0), "compressed": zc, "swapped": zo,
                "swapUsed": m["SwapTotal"] - m["SwapFree"], "swapTotal": m["SwapTotal"],
                "pressure": round(pressure(), 1), "percent": round(100 * (total - avail) / total, 1),
                "top": top_mem},
        "net": {"rx": rxr, "tx": txr, "rxTotal": rx, "txTotal": tx, "iface": iface,
                "ip": ipv4(iface) if iface else "", "gateway": gw,
                "tailscale": ipv4("tailscale0"), "top": top_net, "perApp": bool(nh)},
        "gpu": gpu,
        "sensors": {"cpuTemp": ms.cpu_temp(temps), "power": ms.system_power(powers, bat),
                    "fans": [[l, r] for _, l, r in fans], "hot": [[l, round(v)] for _, l, v in hot],
                    "temps": sensor_groups(temps), "powers": [[l, round(v, 1)] for _, l, v in powers],
                    "fan": fan_state(), "battery": bat},
    }
    tmp = STATE + f".{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump({"t": now, "cpu": ct, "procs": {k: [v[0], v[1]] for k, v in pr.items()},
                   "net": {"rx": rx, "tx": tx},
                   "gpu": {k: g[k] for k in ("busy_ns", "jobs") if k in g} if g else {}, "out": out}, f)
    os.replace(tmp, STATE)
    return out


if __name__ == "__main__":
    print(json.dumps(sample()))
