# Icons for common programs that run without an app or a named service around them.
PROGRAM_ICONS = {
    "ssh": "network-server", "sshd": "network-server", "cloudflared": "network-vpn", "tailscale": "network-vpn",
    "zsh": "utilities-terminal", "bash": "utilities-terminal", "sh": "utilities-terminal", "dash": "utilities-terminal",
    "fish": "utilities-terminal", "sleep": "gnome-clocks", "git": "git", "make": "applications-development",
    "cargo": "applications-development", "docker": "docker", "curl": "network-server",
}
# Programs outside a named service (PID 1, login plumbing, D-Bus-activated helpers), by executable.
PROGRAM_NAMES = {
    "systemd": ["Service Manager", "preferences-system"], "systemd-udevd": ["Device Manager", "hardinfo"],
    "sddm-helper": ["Login Screen", "preferences-system-login"], "(sd-pam)": ["Login Session", "system-users"],
    "startplasma-wayland": ["Plasma Startup", "plasmashell"], "startplasma-way": ["Plasma Startup", "plasmashell"],
