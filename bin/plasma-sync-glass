#!/usr/bin/env python3
"""Keep the dock and popups (Control Center etc.) on one glass tint, and the menu bar clear.

KWin's blur strength is global; what makes surfaces look different is each SVG's tint layer.
For each theme below, the tint of the panel and dialog backgrounds' "center" element (and every
frame part sharing that exact tint) is replaced with the theme's tint. Idempotent; run at login
by ~/.config/systemd/user/plasma-sync-glass.service, before plasmashell. Spotlight
(net.local.spotlight) uses the same values.
"""
import gzip, re, shutil
from pathlib import Path

THEMES = Path.home() / ".local/share/plasma/desktoptheme"
GLASS = ("0.45", "#000000")  # popups, dock; both WhiteSur variants use white text
CLEAR = ("0.35", "#000000")     # menu bar: a light veil so white text stays readable on bright wallpapers
# (svg, tint): the top bars are set to "opaque" so they use solid/ (no blur), made fully clear here
TINTS = [("widgets/panel-background.svgz", GLASS), ("dialogs/background.svgz", GLASS),
         ("solid/widgets/panel-background.svgz", CLEAR)]
THEME_NAMES = ["WhiteSur-dark", "WhiteSur"]
BACKUP = Path.home() / "kde-pre-mac-backup/glass-sync"
changed = False
for theme in THEME_NAMES:
    for rel, (op, fill) in TINTS:
        p = THEMES / theme / rel
        if not p.exists():
            continue
        s = gzip.open(p).read().decode()
        target = f"opacity:{op};fill:{fill}"
        new = s
        for ident in ("center", "north-center"):
            m = re.search(r'<(?:rect|path)[^>]*\bid="%s"[^>]*>' % ident, new)
            st = m and re.search(r'style="([^"]*)"', m.group(0))
            if not st:
                continue
            style = st.group(1)
            pair = re.search(r'opacity:[0-9.]+;fill:#[0-9a-fA-F]{6}', style)
            if pair:   # every frame part sharing this tint
                new = new.replace(pair.group(0), target)
            else:      # bare fill on this element only
                bare = re.search(r'fill:#[0-9a-fA-F]{6}', style)
                if bare:
                    tag = m.group(0)
                    new = new.replace(tag, tag.replace(style, style.replace(bare.group(0), target)), 1)
        if new == s:
            continue
        b = BACKUP / theme / rel
        if not b.exists():
            b.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(p, b)
        gzip.open(p, "wb").write(new.encode())
        print(f"{theme}/{rel}: -> {target}")
        changed = True
if changed:
    for c in (Path.home() / ".cache").glob("plasma_theme_WhiteSur*.kcache"):
        c.unlink()
