#!/usr/bin/env python3
"""Start GNOME Sushi (Quick Look previewer) with a bigger window cap.

Sushi limits its window to 50% of the screen, which makes PDFs tiny. This extracts the
installed mainWindow.js, raises the cap, and starts Sushi with a GLib resource overlay
(G_RESOURCE_OVERLAYS) pointing at the patched copy. If the constants are not found
(Sushi changed), Sushi starts unpatched. Also fixes a null-monitor bug that
keeps the window at its tiny initial size on KWin. Used by the user D-Bus service file
~/.local/share/dbus-1/services/org.gnome.NautilusPreviewer.service.
"""
import os, re
from pathlib import Path

from gi.repository import Gio

RES = "/usr/share/sushi/org.gnome.NautilusPreviewer.src.gresource"
JS = "/org/gnome/NautilusPreviewer/js/core/mainWindow.js"
OUT = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "sushi-overlay" / "mainWindow.js"
CAPS = {"WINDOW_MAX_PERCENT_W": "0.6", "WINDOW_MAX_PERCENT_H": "0.85"}

env = dict(os.environ)
try:
    src = Gio.Resource.load(RES).lookup_data(JS, 0).get_data().decode()
    patched, n = src, 0
    for name, val in CAPS.items():
        patched, k = re.subn(rf"(const {name} = )[0-9.]+;", rf"\g<1>{val};", patched)
        n += k
    # Bug fix: on KWin the window has no monitor yet when Sushi first sizes it, so
    # get_monitor_at_surface() returns null, the size code throws, and the window stays tiny.
    fix_old = "const monitor = display.get_monitor_at_surface(surface);\n        const geometry = monitor.get_geometry();"
    fix_new = ("const monitor = (surface && display.get_monitor_at_surface(surface)) ?? display.get_monitors().get_item(0);\n"
               "        if (!monitor)\n            return [800, 600];\n"
               "        const geometry = monitor.get_geometry();")
    if fix_old in patched:
        patched = patched.replace(fix_old, fix_new)
        n += 1
    if n:
        OUT.parent.mkdir(parents=True, exist_ok=True)
        OUT.write_text(patched)
        env["G_RESOURCE_OVERLAYS"] = f"{JS}={OUT}"
except Exception:
    pass

os.execve("/usr/lib/org.gnome.NautilusPreviewer", ["/usr/lib/org.gnome.NautilusPreviewer"], env)
