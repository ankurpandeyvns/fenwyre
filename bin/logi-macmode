#!/usr/bin/env python3
"""Put every connected Logitech keyboard into macOS mode (Solaar "multiplatform" = MacOS).

Runs once at start, then again a few seconds after any Logitech HID device appears
(new keyboard, Bluetooth reconnect, wake from sleep). Keyboards without the setting are skipped.
Run by ~/.config/systemd/user/logi-macmode.service.
"""
import subprocess, threading

import pyudev

LOGITECH = "0000046D"


def keyboards():
    out = subprocess.run(["solaar", "show"], capture_output=True, text=True, timeout=90).stdout
    names, codename = [], None
    for line in out.splitlines():
        s = line.strip()
        if s.startswith("Codename"):
            codename = s.split(":", 1)[1].strip()
        elif s.startswith("Kind") and s.split(":", 1)[1].strip() == "keyboard" and codename:
            names.append(codename)
            codename = None
    return sorted(set(names))


def apply():
    try:
        for name in keyboards():
            r = subprocess.run(["solaar", "config", name, "multiplatform", "MacOS"],
                               capture_output=True, text=True, timeout=60)
            print(f"{name}: {'MacOS' if r.returncode == 0 else 'skipped: ' + (r.stderr.strip().splitlines() or ['?'])[-1]}", flush=True)
    except Exception as e:  # never die; try again on the next device event
        print("error:", e, flush=True)


timer = None


def schedule(delay=4):
    global timer
    if timer:
        timer.cancel()
    timer = threading.Timer(delay, apply)
    timer.start()


schedule(1)
monitor = pyudev.Monitor.from_netlink(pyudev.Context())
monitor.filter_by("hidraw")
for dev in iter(monitor.poll, None):
    hid = dev.find_parent("hid")
    if dev.action == "add" and hid is not None and LOGITECH in (hid.get("HID_ID") or "").upper():
        schedule()
