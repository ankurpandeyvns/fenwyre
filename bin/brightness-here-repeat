#!/bin/bash
# Owns the brightness shortcuts (MX Keys F1/F2 + Mac brightness keys) as a KDE global-shortcut
# component, so KDE sends it both presses and key-repeats while held. Each event changes the
# display under the mouse via brightness-here.
C=brightness_here
B(){ busctl --user call org.kde.kglobalaccel /kglobalaccel org.kde.KGlobalAccel "$@" >/dev/null; }
reg(){  # action, label, key1, key2  (SetPresent = 2 makes the shortcut active)
  B doRegister as 4 "$C" "$1" "Brightness (display under mouse)" "$2" &&
  B setShortcutKeys 'asa(ai)u' 4 "$C" "$1" "Brightness (display under mouse)" "$2" 2 1 "$3" 1 "$4" 2
}
for _ in $(seq 30); do
  reg up "Brightness up" 16777394 16777265 && reg down "Brightness down" 16777395 16777264 && break
  sleep 1
done

# Each step takes 50-300 ms (DDC, kscreen-doctor), longer than the ~25 ms between key repeats. Events
# that pile up meanwhile are drained, not replayed: one step per drain, and a release drops the repeats
# queued before it, so the level stops when the key is let go.
parse(){  # line -> ev=press|repeat|release, d=up|down; non-zero if not a shortcut event
  case "$1" in
    *globalShortcutPressed*)  ev=press ;;
    *globalShortcutRepeated*) ev=repeat ;;
    *globalShortcutReleased*) ev=release ;;
    *) return 1 ;;
  esac
  case "$1" in *\'up\'*) d=up ;; *\'down\'*) d=down ;; *) return 1 ;; esac
}
held=""
gdbus monitor --session --dest org.kde.kglobalaccel --object-path "/component/$C" 2>/dev/null |
while IFS= read -r line; do
  todo=""
  while :; do
    if parse "$line"; then
      case $ev in
        press)   held=$d; todo="$d press" ;;
        repeat)  [ "$held" = "$d" ] && todo=${todo:-"$d repeat"} ;;
        release) [ "$held" = "$d" ] && held=""; [ "${todo% *}" = "$d" ] && [ "${todo#* }" = repeat ] && todo="" ;;
      esac
    fi
    IFS= read -r -t 0.005 line || break    # anything else already queued?
  done
  [ -n "$todo" ] || continue
  echo "$todo"
  "$HOME/.local/bin/brightness-here" "${todo% *}"
done
