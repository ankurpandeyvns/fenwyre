#!/bin/bash
# Owns the brightness shortcuts (MX Keys F1/F2 + Mac brightness keys) as a KDE global-shortcut
# component, so KDE sends it both presses and key-repeats while held. Each event changes the
# display under the mouse via brightness-here.
C=brightness_here
B(){ busctl --user call org.kde.kglobalaccel /kglobalaccel org.kde.KGlobalAccel "$@" >/dev/null; }
reg(){  # action, label, key1, key2  (SetPresent = 2 makes the shortcut active)
  B doRegister as 4 "$C" "$1" "Brightness (display under mouse)" "$2" &&
  B setShortcutKeys 'asa(ai)u' 4 "$C" "$1" "Brightness (display under mouse)" "$2" 2 1 "$3" 1 "$4" 2
}
for _ in $(seq 30); do
  reg up "Brightness up" 16777394 16777265 && reg down "Brightness down" 16777395 16777264 && break
  sleep 1
done

last=0
gdbus monitor --session --dest org.kde.kglobalaccel --object-path "/component/$C" 2>/dev/null |
while IFS= read -r line; do
  case "$line" in
    *globalShortcutPressed*\'up\'*)    dir=up;   rep=0 ;;
    *globalShortcutPressed*\'down\'*)  dir=down; rep=0 ;;
    *globalShortcutRepeated*\'up\'*)   dir=up;   rep=1 ;;
    *globalShortcutRepeated*\'down\'*) dir=down; rep=1 ;;
    *) continue ;;
  esac
  now=$(date +%s%3N)
  (( rep && now - last < 90 )) && continue   # key repeat is ~40/s; kscreen-doctor needs ~50 ms
  last=$now
  echo "$dir repeat=$rep"
  "$HOME/.local/bin/brightness-here" "$dir"
done
