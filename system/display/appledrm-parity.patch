+	if (kstrtou32(strim((char *)buf), 0, &property))
+		return -EINVAL;
+	ret = dcp_disp0_get_property(dcp, property, &value, &retcode);
+	if (ret)
+		return ret;
+	WRITE_ONCE(dcp->disp0_last_get, ((u64)property << 32) | value);
+	WRITE_ONCE(dcp->disp0_last_retcode, retcode);
+	return count;
+}
