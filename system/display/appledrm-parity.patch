+/*
+ * appledrm.hdr: switching between SDR and HDR10 changes the output's colour
+ * mode, so a change of the HDR metadata or the colorspace is a modeset.
+ */
+static int apple_connector_atomic_check(struct drm_connector *conn,
+					struct drm_atomic_commit *state)
+{
+	struct drm_connector_state *old = drm_atomic_get_old_connector_state(state, conn);
+	struct drm_connector_state *new = drm_atomic_get_new_connector_state(state, conn);
+	struct drm_crtc_state *crtc_state;
+
+	/* The built-in panel keeps its mode: only its planes change (dcp_panel_hdr()). */
+	if (!appledrm_hdr || !new->crtc || conn->connector_type == DRM_MODE_CONNECTOR_eDP)
+		return 0;
+	if (old->colorspace == new->colorspace &&
+	    drm_connector_atomic_hdr_metadata_equal(old, new))
+		return 0;
+	crtc_state = drm_atomic_get_crtc_state(state, new->crtc);
+	if (IS_ERR(crtc_state))
+		return PTR_ERR(crtc_state);
+	crtc_state->mode_changed = true;
+	return 0;
+}
+
+/*
+ * HDR10 needs the Colorspace and HDR_OUTPUT_METADATA properties. A built-in
+ * panel only offers HDR when its EDID says so (dcp_panel_hdr()).
+ */
+static int apple_connector_attach_hdr(struct drm_connector *connector, int type)
+{
+	const u32 bt2020 = BIT(DRM_MODE_COLORIMETRY_BT2020_RGB) |
+			   BIT(DRM_MODE_COLORIMETRY_BT2020_YCC);
+	int ret;
+
+	if (!appledrm_hdr)
+		return 0;
+	if (type == DRM_MODE_CONNECTOR_HDMIA)
+		ret = drm_mode_create_hdmi_colorspace_property(connector, bt2020);
+	else
+		ret = drm_mode_create_dp_colorspace_property(connector, bt2020);
+	if (!ret)
+		ret = drm_connector_attach_colorspace_property(connector);
+	if (ret)
+		return ret;
+	drm_connector_attach_hdr_output_metadata_property(connector);
+	return 0;
+}
+
