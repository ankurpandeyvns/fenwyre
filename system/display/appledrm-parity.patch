+static ssize_t get_property_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct apple_dcp *dcp = dev_get_drvdata(dev);
+	u64 last = READ_ONCE(dcp->disp0_last_get);
