+	if (!service || READ_ONCE(service->torndown))
+		return -ENODEV;
+	put_unaligned_le32(DISP0_OP_GET_PROPERTY, request);
+	put_unaligned_le32(sizeof(request), request + 4);
+	put_unaligned_le32(property, request + 16 + 4);
+	reply = kzalloc(IBOOT_QUERY_RX_SIZE, GFP_KERNEL);
+	if (!reply)
+		return -ENOMEM;
+	*retcode = 0;
