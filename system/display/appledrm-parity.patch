+/* CTA-861 luminance code for @nits: 50 * 2^(code / 32) cd/m2. */
+static u8 cta_max_luminance(u32 nits)
+{
+	if (nits <= 50)
+		return 0;
+	return min_t(u64, 255, ((u64)(intlog2(nits) - intlog2(50)) * 32) >> 24);
+}
+
+/*
+ * A CTA-861 extension for appledrm.hdr: BT.2020 RGB colorimetry and HDR
+ * static metadata (SDR and SMPTE ST 2084 EOTFs, static metadata type 1),
+ * peak and frame-average luminance @nits, the minimum about 0.005 cd/m2.
+ */
+static void cta_hdr_block(u8 *ext, u32 nits)
+{
+	u8 *b = ext + 4;
+
+	memset(ext, 0, EDID_LENGTH);
+	ext[0] = CEA_EXT;
+	ext[1] = 3;
+	ext[3] = BIT(7);	/* IT formats underscanned: the panel shows every pixel */
+	/* Colorimetry data block: extended tag 5, BT2020_RGB. */
+	b[0] = 7 << 5 | 3;
+	b[1] = 0x05;
+	b[2] = BIT(7);
+	b[3] = 0;
+	b += 4;
+	/* HDR static metadata data block: extended tag 6. */
+	b[0] = 7 << 5 | 6;
+	b[1] = 0x06;
+	b[2] = BIT(0) | BIT(2);
+	b[3] = BIT(0);
+	b[4] = cta_max_luminance(nits);
+	b[5] = cta_max_luminance(nits);
+	/* min = max * (code / 255)^2 / 100: code 5 is about 0.004-0.006 cd/m2. */
+	b[6] = 5;
+	b += 7;
+	ext[2] = b - ext;	/* no detailed timings */
+	checksum(ext, EDID_LENGTH);
+}
+
+/* The panel EDID with an HDR10 CTA-861 extension, for a panel lit up to @nits. */
+int dcp_panel_edid_update_hdr(struct drm_connector *connector, const struct dcp_panel_id *id,
+			      int width_mm, int height_mm, u32 nits)
+{
+	const struct drm_edid *edid;
+	u8 *blocks;
+	int ret;
+
+	blocks = kmalloc((DCP_PANEL_EDID_BLOCKS + 1) * EDID_LENGTH, GFP_KERNEL);
+	if (!blocks)
+		return -ENOMEM;
+	ret = dcp_panel_edid_build(id, width_mm, height_mm, blocks);
+	if (ret)
+		goto out;
+	blocks[0x7e] = DCP_PANEL_EDID_BLOCKS;
+	checksum(blocks, EDID_LENGTH);
+	cta_hdr_block(blocks + DCP_PANEL_EDID_BLOCKS * EDID_LENGTH, nits);
+	edid = drm_edid_alloc(blocks, (DCP_PANEL_EDID_BLOCKS + 1) * EDID_LENGTH);
+	if (!edid) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	ret = drm_edid_connector_update(connector, edid);
+	drm_edid_free(edid);
+out:
+	kfree(blocks);
+	return ret;
+}
+
 int dcp_panel_edid_update(struct drm_connector *connector, const struct dcp_panel_id *id,
 			  int width_mm, int height_mm)
 {
