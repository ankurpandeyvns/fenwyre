+ * EDR fields of the 13.5 swap, after the level and the nits cap, for finding
+ * how the firmware runs the mini-LED panel's EDR/HDR path. Runtime knobs in
+ * thousandths, 0 = the field is not sent (the stock behaviour):
+ *  edr_milli       third flag (bl_unk byte 2), binary64 at bl_unk + 21: the
+ *                  display's EDR factor; the firmware scales layers and the
+ *                  PQ table with it
+ *  edr_f4_milli    fourth flag (byte 3), binary64 at bl_unk + 29
+ *  edr_hdr_milli   fifth flag (byte 4), which turns on the firmware's PQ
+ *                  path, and the binary64 at bl_unk + 124 sent with it
+ *  layer_edr_milli each plane's ratio (unk_num / unk_denom) against the factor
+ */
+static unsigned int edr_milli, edr_f4_milli, edr_hdr_milli, layer_edr_milli;
+module_param(edr_milli, uint, 0644);
+MODULE_PARM_DESC(edr_milli, "Experimental: built-in panel EDR factor in 1/1000 (default: 0, not sent)");
+module_param(edr_f4_milli, uint, 0644);
+MODULE_PARM_DESC(edr_f4_milli, "Experimental: fourth swap brightness field in 1/1000 (default: 0, not sent)");
+module_param(edr_hdr_milli, uint, 0644);
+MODULE_PARM_DESC(edr_hdr_milli, "Experimental: fifth swap brightness field (PQ path) in 1/1000 (default: 0, not sent)");
+module_param(layer_edr_milli, uint, 0644);
+MODULE_PARM_DESC(layer_edr_milli, "Experimental: plane EDR ratio in 1/1000 (default: 0, not sent)");
+
+/* @milli / 1000 as IEEE 754 binary64, from 32.32 fixed point. */
+static u64 dcp_milli_binary64(u32 milli)
+{
+	u64 v = div_u64((u64)milli << 32, 1000);
+	int msb;
+
+	if (!v)
+		return 0;
+	msb = fls64(v) - 1;
+	v = msb > 52 ? v >> (msb - 52) : v << (52 - msb);
+	return ((u64)(1023 + msb - 32) << 52) | (v & GENMASK_ULL(51, 0));
+}
+
+static bool dcp_edr_knobs(struct apple_dcp *dcp)
+{
+	return dcp->panel.has_mini_led && dcp->fw_compat == DCP_FIRMWARE_V_13_5 &&
+	       !dcp_backlight_presents_nits(dcp);
+}
+
+/* @bl: the swap's bl_unk; the fields of the knobs above that are set. */
+void dcp_backlight_fill_edr(struct apple_dcp *dcp, u8 *bl)
+{
+	if (!dcp_edr_knobs(dcp))
+		return;
+	if (READ_ONCE(edr_milli)) {
+		bl[2] = 1;
+		put_unaligned_le64(dcp_milli_binary64(READ_ONCE(edr_milli)), bl + 21);
+	}
+	if (READ_ONCE(edr_f4_milli)) {
+		bl[3] = 1;
+		put_unaligned_le64(dcp_milli_binary64(READ_ONCE(edr_f4_milli)), bl + 29);
+	}
+	if (READ_ONCE(edr_hdr_milli)) {
+		bl[4] = 1;
+		put_unaligned_le64(dcp_milli_binary64(READ_ONCE(edr_hdr_milli)), bl + 124);
+	}
+}
+
+/* A plane's EDR ratio as num / denom, or false to leave the plane's zeros. */
+bool dcp_backlight_layer_edr(struct apple_dcp *dcp, u32 *num, u32 *denom)
+{
+	u32 milli = READ_ONCE(layer_edr_milli);
+
+	if (!milli || !dcp_edr_knobs(dcp))
+		return false;
+	*num = milli;
+	*denom = 1000;
+	return true;
+}
+
+/* The XDR ceiling in nits, or 0 when the panel runs at its SDR maximum. */
+u32 dcp_backlight_xdr_nits(struct apple_dcp *dcp)
+{
+	u32 nits = min(xdr_nits, DCP_XDR_MAX_NITS);
+
+	if (!dcp->panel.has_mini_led || dcp->fw_compat != DCP_FIRMWARE_V_13_5 ||
+	    !dcp->brightness.maximum || nits <= dcp->brightness.maximum ||
+	    dcp_backlight_presents_nits(dcp))
+		return 0;
+	return nits;
+}
+
+/*
+ * appledrm.hdr on a mini-LED panel: its EDID claims PQ and BT.2020 up to the
+ * backlight's maximum, and PQ BT.2020 planes are passed to the firmware as
+ * such, which maps them onto the panel (KWin runs the backlight at full in HDR).
+ */
+bool dcp_panel_hdr(struct apple_dcp *dcp)
+{
+	return appledrm_hdr && dcp->panel.has_mini_led &&
+	       dcp->fw_compat == DCP_FIRMWARE_V_13_5 && dcp->brightness.maximum &&
+	       !dcp_backlight_presents_nits(dcp);
+}
+
+/* The highest level the backlight takes, in nits. */
+u32 dcp_backlight_max_nits(struct apple_dcp *dcp)
+{
+	return dcp_backlight_xdr_nits(dcp) ?: dcp->brightness.maximum;
+}
+
+/* Integral nits as IEEE 754 binary64, without kernel floating point. */
+u64 dcp_nits_binary64(u32 nits)
+{
+	unsigned int bit;
+
+	if (!nits)
+		return 0;
+	bit = fls(nits) - 1;
+	return ((u64)(1023 + bit) << 52) |
+	       ((u64)(nits - (1U << bit)) << (52 - bit));
+}
