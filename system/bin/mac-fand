#!/usr/bin/python3 -I
"""mac-fand: macOS-style fan profiles for Apple silicon Macs on Asahi (kde-macos-parity).

Needs the patched macsmc-hwmon (system/fan/): fan_control=1 makes fanN_target writable, fan_stop=1
lets a target below the fan minimum stop the fan, and the SoC die keys give the macsmc_soc_die
thermal zone (hottest of the CPU/GPU die sensors, the same ones Stats/iStat show on macOS).

Profile (one word in /var/lib/mac-fan/profile, re-read every cycle):
  macos   silence first, like Apple: fans stay off while the chip is cool or only briefly busy; once
          the smoothed die temperature passes 60 C and the trend predicts it will keep climbing, the
          fans start at their minimum and creep up only as fast as the predicted overshoot of 80 C
          demands. Full speed only when the chip is at 90 C or more, still rising, with the fans
          already past 60%: the point where airflow, not silence, has to win. Off again once below
          58 C for 30 s. (default)
  high    the same controller tuned for temperature over silence (like macOS "High Power"):
          starts at 50 C, holds about 70 C, ramps four times faster
  max     both fans at full speed
  apple   hand the fans to the SMC firmware (what Linux does without this daemon)

Safety: any read error, a missing die zone, or a die at or above 95 C hands the fans back to the SMC
(target 0) until the next good reading below 90 C; on exit the fans go back to the SMC too.
Status for the menu bar widget: /run/mac-fan/state.json.
"""
import glob, json, os, signal, sys, time

PROFILE_FILE = "/var/lib/mac-fan/profile"
STATE_DIR = "/run/mac-fan"
PERIOD = 2.0
# Controller tuning per profile:
#   start    smoothed die temperature at which the fans may start
#   stop     ... below which they stop again (after STOP_AFTER seconds)
#   hold     temperature the controller steers the predicted value towards while the fans run
#   up/down  speed change per cycle, as a fraction of the fan range per degree of predicted error
TUNING = {
    "macos": dict(start=60.0, stop=58.0, hold=80.0, up=0.0015, down=0.0008),
    "high": dict(start=50.0, stop=48.0, hold=70.0, up=0.006, down=0.002),
}
STOP_AFTER = 30.0    # seconds below `stop` before the fans stop (no on/off flapping)
SMOOTH_TAU = 10.0    # s, die temperature smoothing (ignores short bursts)
TREND_WINDOW = 30.0  # s of history for the temperature trend
HORIZON = 60.0       # s ahead the controller predicts
MAX_AT = 90.0        # full speed when at/above this, still rising, and the fans past MAX_FROM
MAX_FROM = 0.6
MAX_RELEASE = 85.0   # leave full speed below this
EMERGENCY, EMERGENCY_CLEAR = 95.0, 90.0


def read(path):
    with open(path) as f:
        return f.read().strip()


def hwmon_dir():
    for d in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            if read(f"{d}/name") == "macsmc_hwmon":
                return d
        except OSError:
            pass
    return None


def die_temp():
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        try:
            if read(f"{z}/type") == "macsmc_soc_die":
                return int(read(f"{z}/temp")) / 1000.0
        except (OSError, ValueError):
            pass
    return None


def param(name):
    try:
        return read(f"/sys/module/macsmc_hwmon/parameters/{name}") == "Y"
    except OSError:
        return False


class Fans:
    def __init__(self, hw):
        self.hw = hw
        self.ids = sorted(int(p.split("fan")[1].split("_")[0]) for p in glob.glob(f"{hw}/fan*_target"))
        self.last = {}

    def limits(self, i):
        return int(read(f"{self.hw}/fan{i}_min")), int(read(f"{self.hw}/fan{i}_max"))

    def rpm(self, i):
        return int(read(f"{self.hw}/fan{i}_input"))

    def set(self, i, value):
        if self.last.get(i) == value:
            return
        with open(f"{self.hw}/fan{i}_target", "w") as f:
            f.write(str(int(value)))
        self.last[i] = value

    def release(self):
        for i in self.ids:
            try:
                with open(f"{self.hw}/fan{i}_target", "w") as f:
                    f.write("0")
            except OSError:
                pass
        self.last = {}


def profile():
    try:
        p = read(PROFILE_FILE).lower()
    except OSError:
        p = "macos"
    return p if p in ("macos", "high", "max", "apple") else "macos"


def write_state(state):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = f"{STATE_DIR}/state.json.tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, f"{STATE_DIR}/state.json")


def main():
    hw = hwmon_dir()
    if not hw or not param("fan_control"):
        print("macsmc_hwmon with fan_control=1 not loaded; leaving the fans to the SMC", file=sys.stderr)
        return 1
    fans = Fans(hw)
    can_stop = param("fan_stop")
    running = {"on": True}

    def stop(*_):
        running["on"] = False
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    spinning = False
    speed = 0.0            # 0..1 of the fan range (min..max rpm) while spinning
    full = False
    cool_since = None
    emergency = False
    smooth = None
    history = []           # (monotonic time, smoothed temperature)
    try:
        while running["on"]:
            p = profile()
            t = die_temp()
            now = time.monotonic()
            mode = p
            pred = None
            if t is not None:
                a = 1.0 - pow(2.718281828, -PERIOD / SMOOTH_TAU)
                smooth = t if smooth is None else smooth + a * (t - smooth)
                history.append((now, smooth))
                history = [h for h in history if now - h[0] <= TREND_WINDOW]
                slope = 0.0
                if len(history) >= 4:   # least-squares slope, C per second
                    n = len(history); mx = sum(h[0] for h in history) / n; my = sum(h[1] for h in history) / n
                    den = sum((h[0] - mx) ** 2 for h in history)
                    slope = sum((h[0] - mx) * (h[1] - my) for h in history) / den if den else 0.0
                pred = smooth + max(0.0, slope) * HORIZON
            try:
                if t is None or (t >= EMERGENCY) or (emergency and t >= EMERGENCY_CLEAR):
                    emergency = t is None or t >= EMERGENCY_CLEAR
                    fans.release(); mode = "apple (safety)" if p != "apple" else "apple"
                    spinning, speed, full = True, 1.0, False
                elif p == "apple":
                    emergency = False
                    fans.release(); spinning, speed, full = True, 0.0, False
                elif p == "max":
                    emergency = False
                    for i in fans.ids:
                        fans.set(i, fans.limits(i)[1])
                    spinning, speed, full = True, 1.0, False
                else:
                    emergency = False
                    k = TUNING[p]
                    if not spinning:
                        if smooth >= k["start"] and pred >= k["hold"] - 10.0:
                            spinning, speed, cool_since = True, 0.0, None
                    else:
                        if smooth < k["stop"]:
                            cool_since = cool_since or now
                            if now - cool_since >= STOP_AFTER:
                                spinning, speed, full = False, 0.0, False
                        else:
                            cool_since = None
                    if spinning:
                        err = pred - k["hold"]
                        speed += (k["up"] if err > 0 else k["down"]) * err
                        speed = max(0.0, min(1.0, speed))
                        if t >= MAX_AT and slope > 0 and speed >= MAX_FROM:
                            full = True
                        elif full and smooth < MAX_RELEASE:
                            full = False
                    mode = p + (" (full)" if full else "" if spinning else " (silent)")
                    for i in fans.ids:
                        lo, hi = fans.limits(i)
                        if not spinning:
                            want = 1 if can_stop else lo        # 1 = below minimum = stop
                        else:
                            want = hi if full else lo + (hi - lo) * speed
                        fans.set(i, round(want))
            except OSError as e:
                print(f"fan write failed ({e}); handing the fans to the SMC", file=sys.stderr)
                fans.release(); mode = "apple (error)"
            try:
                write_state({"profile": p, "mode": mode, "die": t, "smooth": smooth, "predicted": pred,
                             "speed": round(speed, 3), "full": full,
                             "fans": [{"id": i, "rpm": fans.rpm(i), "target": fans.last.get(i, 0)} for i in fans.ids],
                             "canStop": can_stop, "time": time.time()})
            except OSError:
                pass
            time.sleep(PERIOD)
    finally:
        fans.release()
        try:
            write_state({"profile": profile(), "mode": "apple (daemon stopped)", "die": die_temp(), "fans": [],
                         "canStop": can_stop, "time": time.time()})
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
