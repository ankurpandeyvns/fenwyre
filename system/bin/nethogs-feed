#!/usr/bin/env python3
"""nethogs-feed: per-process network rates for the Mac Stats plasmoid.

Runs `nethogs -t` (needs root for packet capture) and, after every refresh, writes
/run/mac-stats/net.json: {"t": epoch, "procs": [[pid, sent_Bps, recv_Bps], ...]}.
Only PIDs and rates are written — no command lines.
"""
import json, os, subprocess, sys, time

OUT_DIR = "/run/mac-stats"
OUT = os.path.join(OUT_DIR, "net.json")


def write(procs):
    tmp = OUT + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"t": time.time(), "procs": procs}, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, OUT)


def main():
    os.makedirs(OUT_DIR, mode=0o755, exist_ok=True)
    p = subprocess.Popen(["nethogs", "-t", "-C", "-d", "2", "-v", "0"],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1)
    frame, started = [], False
    for line in p.stdout:
        line = line.rstrip("\n")
        if line.startswith("Refreshing:"):
            if started:
                write(frame)
            frame, started = [], True
            continue
        if not started or "\t" not in line:
            continue
        try:
            ident, sent, recv = line.rsplit("\t", 2)
            _prog, pid, _uid = ident.rsplit("/", 2)
            s, r = float(sent) * 1024, float(recv) * 1024   # KB/s -> B/s
        except ValueError:
            continue
        if s > 0 or r > 0:
            frame.append([int(pid), round(s), round(r)])
    sys.exit(p.wait() or 1)


if __name__ == "__main__":
    main()
