--- breeze/Main.qml
+++ breeze-mac/Main.qml
@@ -32,6 +32,17 @@
 
     property string notificationMessage
 
+    // kde-macos-parity: like macOS, the login form appears on the main display only; the other
+    // screens show the wallpaper. theme.conf primaryOutput names it (KWin connector name); if that
+    // output isn't connected, SDDM's primary screen is used.
+    readonly property bool isMainScreen: {
+        const want = config.primaryOutput || "";
+        const names = [];
+        for (let i = 0; i < Qt.application.screens.length; i++) names.push(Qt.application.screens[i].name);
+        if (want !== "" && names.indexOf(want) >= 0) return Screen.name === want;
+        return typeof primaryScreen === "undefined" ? true : primaryScreen;
+    }
+
     LayoutMirroring.enabled: Application.layoutDirection === Qt.RightToLeft
     LayoutMirroring.childrenInherit: true
 
@@ -63,6 +74,8 @@
     MouseArea {
         id: loginScreenRoot
         anchors.fill: parent
+        visible: root.isMainScreen
+        enabled: root.isMainScreen
 
         property bool uiVisible: true
         property bool blockUI: mainStack.depth > 1 || userListComponent.mainPasswordBox.text.length > 0 || Keyboards.KWinVirtualKeyboard.visible || config.type !== "image"
