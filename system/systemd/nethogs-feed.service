[Unit]
Description=Per-process network rates for the Mac Stats panel widget (nethogs)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/nethogs-feed
Restart=always
RestartSec=5
Nice=10
# nethogs only watches interfaces that were up when it started; refresh hourly so new ones get picked up.
RuntimeMaxSec=1h
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/mac-stats
RuntimeDirectory=mac-stats
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
