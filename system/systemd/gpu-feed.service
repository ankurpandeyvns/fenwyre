[Unit]
Description=Per-process GPU time for the Mac Stats panel widget (DRM scheduler tracepoints)
ConditionPathExists=/sys/kernel/tracing/events/gpu_scheduler

[Service]
ExecStart=/usr/local/bin/gpu-feed
Restart=always
RestartSec=5
Nice=10
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/mac-stats /sys/kernel/tracing
RuntimeDirectory=mac-stats
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
PrivateNetwork=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
