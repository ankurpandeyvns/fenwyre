//
//  System 1 Control Panel
//  Macintosh 40th Anniversary - AUTHORED program (not from Apple)
//
//  Written for the KDE Plasma "Macintosh" wallpaper in the style of Apple's
//  IconGarden.program / System6ControlPanel.program. Extensions used beyond
//  Apple's command set are marked [ext].
//
//-------------------------------------------------------------------------------------------------------------------------------------------------

start simultaneous
	scale out
	let image = "System1ControlPanel"
	let cursor = "None"
	let ramp = "None"
	add radiobuttongroup
	add radiobutton at 155, 247 value 0 name "RadioButtonSystem1Number1" action "click1"
	add radiobutton at 174, 247 value 1 name "RadioButtonSystem1Number0" action "click0"
end simultaneous

gosub title
gosub mouse
gosub keyboard
gosub volume

exit

//-------------------------------------------------------------------------------------------------------------------------------------------------

title:

	start simultaneous
		let scene = "title"
		let cursor = "None"
		let ramp = "Right"
		camera to -22.5, 45
		scroll to 130, 92
	end simultaneous

	scroll to 390, 92 over 22 seconds async "scroll"
	scale in over 3 seconds

	wait until 3 seconds before "scroll" completes
	scale out over 3 seconds

	return

//-------------------------------------------------------------------------------------------------------------------------------------------------

mouse:

	start simultaneous
		let scene = "mouse"
		let cursor = "Automatic"
		let ramp = "Right"
		camera to 22.5, 45
		mouse to 230, 270
		scroll to 140, 228
		reset controls
	end simultaneous

	scroll to 220, 228 over 15 seconds async "scroll"
	scale in over 3 seconds

	wait for 1.5 seconds
	mouse to 163, 240 over 1.5 seconds curve easeout
	wait for 0.5 seconds
	mouse click
	wait for 1.5 seconds
	mouse to 182, 240 over 0.75 seconds curve easeout
	wait for 0.5 seconds
	mouse click
	wait for 1.5 seconds
	mouse to 163, 240 over 0.75 seconds curve easeout
	wait for 0.5 seconds
	mouse click
	wait for 1 second
	mouse to 240, 260 over 1.5 seconds curve easeout

	wait until 3 seconds before "scroll" completes
	scale out over 3 seconds

	return

//-------------------------------------------------------------------------------------------------------------------------------------------------

keyboard:

	start simultaneous
		let scene = "keyboard"
		let cursor = "None"
		let ramp = "Left"
		camera to -22.5, 45
		scroll to 350, 165
	end simultaneous

	scroll to 160, 165 over 20 seconds async "scroll"
	scale in over 3 seconds

	wait until 3 seconds before "scroll" completes
	scale out over 3 seconds

	return

//-------------------------------------------------------------------------------------------------------------------------------------------------

volume:

	start simultaneous
		let scene = "volume"
		let cursor = "None"
		let ramp = "Up"
		camera to 22.5, 45
		scroll to 128, 235
	end simultaneous

	scroll to 128, 115 over 15 seconds async "scroll"
	scale in over 3 seconds

	wait until 3 seconds before "scroll" completes
	scale out over 3 seconds

	return

//-------------------------------------------------------------------------------------------------------------------------------------------------
