//
//  MacPaint
//  Macintosh 40th Anniversary - AUTHORED program (not from Apple)
//
//  Written for the KDE Plasma "Macintosh" wallpaper in the style of Apple's
//  IconGarden.program / System6ControlPanel.program. Extensions used beyond
//  Apple's command set are marked [ext].
//
//-------------------------------------------------------------------------------------------------------------------------------------------------

start simultaneous
	scale out
	let image = "MacPaint"
	let cursor = "None"
	let ramp = "None"
end simultaneous

gosub drawing
gosub tools
gosub patterns

exit

//-------------------------------------------------------------------------------------------------------------------------------------------------

drawing:

	start simultaneous
		let scene = "drawing"
		let cursor = "Pencil"
		let ramp = "Right"
		camera to -22.5, 45
		mouse to 150, 262
		scroll to 120, 160
	end simultaneous

	scroll to 300, 200 over 24 seconds async "scroll"
	scale in over 3 seconds

	wait for 2 seconds
	mouse to 175, 270 over 2 seconds curve easeout
	wait for 1 second
	mouse to 230, 268 over 3 seconds curve easeout
	wait for 1 second
	mouse to 300, 240 over 4 seconds curve easeout

	wait until 3 seconds before "scroll" completes
	scale out over 3 seconds

	return

//-------------------------------------------------------------------------------------------------------------------------------------------------

tools:

	start simultaneous
		let scene = "tools"
		let cursor = "None"
		let ramp = "Down"
		camera to 22.5, 45
		scroll to 40, 40
	end simultaneous

	scroll to 40, 260 over 20 seconds async "scroll"
	scale in over 3 seconds

	wait until 3 seconds before "scroll" completes
	scale out over 3 seconds

	return

//-------------------------------------------------------------------------------------------------------------------------------------------------

patterns:

	start simultaneous
		let scene = "patterns"
		let cursor = "None"
		let ramp = "Left"
		camera to -22.5, 45
		scroll to 480, 318
	end simultaneous

	scroll to 110, 318 over 26 seconds async "scroll"
	scale in over 3 seconds

	wait until 3 seconds before "scroll" completes
	scale out over 3 seconds

	return

//-------------------------------------------------------------------------------------------------------------------------------------------------
